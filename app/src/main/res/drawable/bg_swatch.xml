<?xml version="1.0" encoding="utf-8"?>
<!-- Tinted per swatch via android:backgroundTint. Selected = ring + dot, normal = dot. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="#FF000000" />
                </shape>
            </item>
            <item
                android:bottom="5dp"
                android:left="5dp"
                android:right="5dp"
                android:top="5dp">
                <shape android:shape="oval">
                    <solid android:color="#FF000000" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:bottom="3dp"
                android:left="3dp"
                android:right="3dp"
                android:top="3dp">
                <shape android:shape="oval">
                    <solid android:color="#FF000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
